# rsync2backup client configuration

# Backup server hostname or IP
RSYNC_SERVER=192.168.1.100

# SSH port on the backup server (default 22, commonly changed to 2222 or similar)
RSYNC_PORT=2222

# SSH username on the server
USER_NAME=transfer

# Numeric UID and GID for the transfer user on the server
RSYNC_UID=1000
RSYNC_GID=1000

# Sync direction: 1 = push (upload to server), 0 = pull (download from server)
PUSH=1

# Directory containing SSH keys (will be mounted to /data/sshkeys in container)
KEY_DIR=./sshkeys

# Directory to sync with the server (will be mounted to /upload in container)
SOURCE_DIR=./data

# Server-side configuration directory (optional, defaults to /data/config if not set)
# Only used when generating docker-compose.yml on first run
SERVER_CONFIG_DIR=/data/config

# Server-side data directory (optional, defaults to /data/transfer_target if not set)
# Only used when generating docker-compose.yml on first run
SERVER_DATA_DIR=/data/transfer_target

