# rsync2backup server configuration

# Public key directory containing authorized SSH keys for the transfer user
PUBLIC_KEY_DIR=./keys

# Server-side configuration directory (linuxserver/openssh-server uses this for config)
SERVER_CONFIG_DIR=./config

# Server-side data directory where backups are stored
SERVER_DATA_DIR=./data

# User ID for the transfer user (should match RSYNC_UID on the client side)
PUID=1000

# Group ID for the transfer user (should match RSYNC_GID on the client side)
PGID=1000

# SSH port to expose (internal 2222 is mapped to this port on the host)
RSYNC_PORT=2222

